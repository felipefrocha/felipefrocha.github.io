# Cloudflare Turnstile (contact form) — public site key
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Supabase (blog comments) — publishable/anon key is safe to expose in the client;
# writes are protected by Row Level Security (login required, self-only).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile secret (contact form Pages Function) — set as an encrypted
# Pages secret in production, and in .dev.vars locally. Never commit the real value.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
